; Engine configuration file.
; เสพติดการโดดเรียน – Skip class addicted

config_version=5

[application]

config/name="เสพติดการโดดเรียน – Skip class addicted"
config/description="เกม 2D แนว Stealth-Puzzle Platformer ในโรงเรียนไทย"
config/version="0.1.0-demo"
run/main_scene="res://game/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.047, 0.071, 0.125, 1)
config/icon="res://game/art/icon.svg"

[autoload]

GameState="*res://game/scripts/game_state.gd"
AudioManager="*res://game/scripts/audio_manager.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.047, 0.071, 0.125, 1)

[audio]

driver/enable_input=false

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="NPC"
2d_physics/layer_4="Sensor"
